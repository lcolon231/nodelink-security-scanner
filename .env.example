# SQLite for local dev. Swap to Postgres in production:
# DATABASE_URL="postgresql://user:pass@host:5432/nodelink"
DATABASE_URL="file:./dev.db"

# Per-IP rate limit (scans per window)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=900000

# Optional: branding overrides
NEXT_PUBLIC_BRAND_NAME="NodeLink Technologies"
NEXT_PUBLIC_BRAND_ACCENT="#844EEE"