generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Scan {
  id          String      @id @default(cuid())
  domain      String
  status      String
  riskScore   Int?
  errorMsg    String?
  startedAt   DateTime    @default(now())
  completedAt DateTime?
  findings    Finding[]
  events      ScanEvent[]

  @@index([domain])
  @@index([startedAt])
}

model Finding {
  id          String   @id @default(cuid())
  scanId      String
  scan        Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  category    String
  checkId     String
  title       String
  severity    String
  passed      Boolean
  description String
  remediation String
  evidence    String?
  createdAt   DateTime @default(now())

  @@index([scanId])
}

model ScanEvent {
  id         String   @id @default(cuid())
  scanId     String?
  scan       Scan?    @relation(fields: [scanId], references: [id], onDelete: SetNull)
  eventType  String
  domain     String?
  ipAddress  String?
  country    String?
  userAgent  String?
  referrer   String?
  durationMs Int?
  score      Int?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
  @@index([domain])
}
